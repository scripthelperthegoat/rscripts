local movementElapsed = 0
local lightingElapsed = 0

SpiderHub.Connections.Heartbeat = RunService.Heartbeat:Connect(function(deltaTime)
    if not SpiderHub.Running then
        return
    end

    ESP_Loop()
    movementElapsed = movementElapsed + deltaTime
    lightingElapsed = lightingElapsed + deltaTime

    if movementElapsed >= 0.5 then
        movementElapsed = 0
        ApplyMovement()
    end

    if lightingElapsed >= 1 then
        lightingElapsed = 0

        if SpiderHub.Flags.Fullbright then
            ApplyFullbright()
        end
    end
end)

SpiderHub.Connections.JumpRequest = UserInputService.JumpRequest:Connect(function()
    if not SpiderHub.Running or not SpiderHub.Flags.InfiniteJump then
        return
    end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

SpiderHub.Connections.CharacterRemoving = LocalPlayer.CharacterRemoving:Connect(function(character)
    local pickup = SpiderHub.ActivePickup

    if pickup and pickup.Character == character then
        CancelPickup()
    end

    RestoreMovement(character)
    FixCollision(character)
end)

