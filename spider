local function Disconnect(connection)
    if connection and connection.Connected then
        connection:Disconnect()
    end
end

local function Notify(title, content, icon)
    if SpiderHub.Running then
        WindUI:Notify({
            Title = title,
            Content = content,
            Icon = icon or "info",
            Duration = 4
        })
    end
end

local function SetHumanoidProperty(humanoid, property, value)
    local defaults = SpiderHub.HumanoidDefaults[humanoid]

    if not defaults then
        defaults = {}
        SpiderHub.HumanoidDefaults[humanoid] = defaults
    end

    if defaults[property] == nil then
        defaults[property] = humanoid[property]
    end

    humanoid[property] = value
end

local function RestoreMovement(character)
    for humanoid, defaults in pairs(SpiderHub.HumanoidDefaults) do
        if not character or humanoid:IsDescendantOf(character) then
            if humanoid.Parent then
                for property, value in pairs(defaults) do
                    humanoid[property] = value
                end
            end

            SpiderHub.HumanoidDefaults[humanoid] = nil
        end
    end
end

local function FixCollision(character)
    for part, canCollide in pairs(SpiderHub.CollisionDefaults) do
        if not character or part:IsDescendantOf(character) then
            if part.Parent then
                part.CanCollide = canCollide
            end

            SpiderHub.CollisionDefaults[part] = nil
        end
    end
end

local function RestoreLighting()
    if not SpiderHub.LightingDefaults then
        return
    end

    for property, value in pairs(SpiderHub.LightingDefaults) do
        Lighting[property] = value
    end

    SpiderHub.LightingDefaults = nil
end

local function ApplyFullbright()
    Lighting.Brightness = 2
    Lighting.ClockTime = 14
    Lighting.FogEnd = 100000
    Lighting.GlobalShadows = false
    Lighting.Ambient = Color3.fromRGB(255, 255, 255)
end

local function ToggleFullbright(state)
    if not SpiderHub.Running then
        return
    end

    SpiderHub.Flags.Fullbright = state

    if state then
        if not SpiderHub.LightingDefaults then
            SpiderHub.LightingDefaults = {
                Brightness = Lighting.Brightness,
                ClockTime = Lighting.ClockTime,
                FogEnd = Lighting.FogEnd,
                GlobalShadows = Lighting.GlobalShadows,
                Ambient = Lighting.Ambient
            }
        end

        ApplyFullbright()
    else
        RestoreLighting()
    end
end

local function ToggleNoclip(state)
    if not SpiderHub.Running then
        return
    end

    SpiderHub.Flags.Noclip = state
    Disconnect(SpiderHub.Connections.Noclip)
    SpiderHub.Connections.Noclip = nil

    if state then
        SpiderHub.Connections.Noclip = RunService.Stepped:Connect(function()
            local character = LocalPlayer.Character

            if not SpiderHub.Running or not SpiderHub.Flags.Noclip or not character then
                return
            end

            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") and not part:FindFirstAncestorOfClass("Tool") and part.CanCollide then
                    if SpiderHub.CollisionDefaults[part] == nil then
                        SpiderHub.CollisionDefaults[part] = part.CanCollide
                    end

                    part.CanCollide = false
                end
            end
        end)
    else
        FixCollision()
    end
end

local function EscapeRichText(text)
    local escaped = text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    return escaped
end

local function GetInventoryString(targetPlayer)
    local items = {}
    local seen = {}
    local character = targetPlayer.Character
    local backpack = targetPlayer:FindFirstChildOfClass("Backpack")

    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") and not seen[tool.Name] then
                table.insert(items, "[" .. EscapeRichText(tool.Name) .. "]")
                seen[tool.Name] = true
            end
        end
    end

    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and not seen[tool.Name] then
                table.insert(items, EscapeRichText(tool.Name))
                seen[tool.Name] = true
            end
        end
    end

    if #items > 0 then
        return table.concat(items, " + ")
    end

    return nil
end

local function RemoveESP(category, key)
    local entry = SpiderHub.ESP_DB[category][key]

    if not entry then
        return
    end

    if entry.Highlight then
        entry.Highlight:Destroy()
    end

    if entry.Billboard then
        entry.Billboard:Destroy()
    end

    SpiderHub.ESP_DB[category][key] = nil
end

local function ClearESP(category)
    for key in pairs(SpiderHub.ESP_DB[category]) do
        RemoveESP(category, key)
    end
end

local function ClearAllESP()
    ClearESP("Players")
    ClearESP("Items")
end

local function GetESPPart(model)
    local part = model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Handle")
        or model.PrimaryPart
        or model:FindFirstChild("Hitbox")

    if part and part:IsA("BasePart") then
        return part
    end

    return model:FindFirstChildWhichIsA("BasePart", true)
end

local function CreateESPObj(model, color, name)
    local root = GetESPPart(model)

    if not root then
        return nil
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "SpiderESP_H"
    highlight.FillColor = color
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = model
    highlight.Parent = CoreGui

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "SpiderESP_B"
    billboard.Adornee = root
    billboard.Size = UDim2.fromOffset(240, 60)
    billboard.StudsOffset = Vector3.new(0, 4, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = CoreGui

    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "MainText"
    textLabel.Size = UDim2.fromScale(1, 1)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = EscapeRichText(name)
    textLabel.TextColor3 = color
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextStrokeTransparency = 0
    textLabel.TextSize = 13
    textLabel.RichText = true
    textLabel.Parent = billboard

    return {
        Highlight = highlight,
        Billboard = billboard,
        Root = root,
        Model = model,
        TextLabel = textLabel
    }
end

local function ESP_Loop()
    if not SpiderHub.Running then
        return
    end

    if SpiderHub.Flags.ESP_Player then
        for targetPlayer, entry in pairs(SpiderHub.ESP_DB.Players) do
            if not targetPlayer.Parent or targetPlayer.Character ~= entry.Model or not entry.Model.Parent or not entry.Root.Parent then
                RemoveESP("Players", targetPlayer)
            end
        end

        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            if targetPlayer ~= LocalPlayer and targetPlayer.Character and targetPlayer.Character.Parent then
                local entry = SpiderHub.ESP_DB.Players[targetPlayer]

                if not entry then
                    entry = CreateESPObj(targetPlayer.Character, Theme.Red, targetPlayer.Name)
                    SpiderHub.ESP_DB.Players[targetPlayer] = entry
                end

                if entry then
                    local inventory = GetInventoryString(targetPlayer)
                    local name = EscapeRichText(targetPlayer.Name)

                    if inventory then
                        entry.TextLabel.Text = name .. "\n<font size='11' color='rgb(255,215,0)'>" .. inventory .. "</font>"
                    else
                        entry.TextLabel.Text = name
                    end
                end
            end
        end
    else
        ClearESP("Players")
    end

    local folder = Workspace:FindFirstChild("Items")

    if SpiderHub.Flags.ESP_Item and folder then
        for item, entry in pairs(SpiderHub.ESP_DB.Items) do
            if item.Parent ~= folder or not entry.Root.Parent or not entry.Root:IsDescendantOf(item) then
                RemoveESP("Items", item)
            end
        end

        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Model") and not SpiderHub.ESP_DB.Items[item] then
                SpiderHub.ESP_DB.Items[item] = CreateESPObj(item, Theme.Accent, item.Name)
            end
        end
    else
        ClearESP("Items")
    end
end

local function RestorePickupPosition(pickup)
    if not pickup or pickup.Restored then
        return
    end

    pickup.Restored = true

    if LocalPlayer.Character == pickup.Character and pickup.Root.Parent and pickup.Character.PrimaryPart == pickup.Root then
        pickup.Character:SetPrimaryPartCFrame(pickup.OriginalCFrame)
    end

    if pickup.Completed and SpiderHub.ActivePickup == pickup then
        SpiderHub.ActivePickup = nil
    end
end

local function CancelPickup()
    local pickup = SpiderHub.ActivePickup

    if not pickup then
        return
    end

    if pickup.Thread and coroutine.status(pickup.Thread) ~= "dead" then
        task.cancel(pickup.Thread)
    end

    pickup.Completed = true
    RestorePickupPosition(pickup)
    SpiderHub.ActivePickup = nil
end

local function SecureTeleportAndSwap(itemModel)
    if not SpiderHub.Running then
        return
    end

    if SpiderHub.ActivePickup then
        Notify("Pickup in Progress", "Wait for the current item pickup to finish.", "clock")
        return
    end

    local folder = Workspace:FindFirstChild("Items")
    local character = LocalPlayer.Character

    if not itemModel or itemModel.Parent ~= folder or not folder then
        Notify("Item Unavailable", "This item is no longer available. Select another item.", "triangle-alert")
        return
    end

    local targetPart = itemModel:FindFirstChild("Hitbox") or itemModel:FindFirstChild("Handle")
    local modules = ReplicatedStorage:FindFirstChild("modules")
    local up = modules and modules:FindFirstChild("up")
    local network = up and up:FindFirstChild("Network")
    local remote = network and network:FindFirstChild("RemoteFunction")

    if not targetPart or not targetPart:IsA("BasePart") or not character or not character.PrimaryPart then
        Notify("Pickup Unavailable", "The item or your character is not ready yet.", "triangle-alert")
        return
    end

    if not remote or not remote:IsA("RemoteFunction") then
        Notify("Pickup Unavailable", "The game's item pickup connection is unavailable.", "triangle-alert")
        return
    end

    local pickup = {
        Character = character,
        Root = character.PrimaryPart,
        OriginalCFrame = character.PrimaryPart.CFrame,
        Restored = false,
        Completed = false
    }

    SpiderHub.ActivePickup = pickup
    character:SetPrimaryPartCFrame(targetPart.CFrame)

    pickup.Thread = task.spawn(function()
        for _ = 1, 10 do
            if not SpiderHub.Running or LocalPlayer.Character ~= character or itemModel.Parent ~= folder or not targetPart:IsDescendantOf(itemModel) then
                break
            end

            pcall(function()
                remote:InvokeServer("AttemptSwapItems", targetPart)
            end)

            RunService.Heartbeat:Wait()
        end

        pickup.Completed = true

        if pickup.Restored and SpiderHub.ActivePickup == pickup then
            SpiderHub.ActivePickup = nil
        end
    end)

    task.wait(0.25)
    RestorePickupPosition(pickup)
end

local function SetMovement(flag, value)
    if not SpiderHub.Running then
        return
    end

    SpiderHub.Flags[flag] = value
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        SetHumanoidProperty(humanoid, flag, value)
    end
end

local function ApplyMovement()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    if SpiderHub.Flags.WalkSpeed ~= 16 then
        SetHumanoidProperty(humanoid, "WalkSpeed", SpiderHub.Flags.WalkSpeed)
    end

    if SpiderHub.Flags.JumpPower > 0 then
        SetHumanoidProperty(humanoid, "JumpPower", SpiderHub.Flags.JumpPower)
    end
end

local function UnloadScript()
    if not SpiderHub.Running then
        return
    end

    SpiderHub.Running = false
    SpiderHub.Flags.Noclip = false
    SpiderHub.Flags.ESP_Player = false
    SpiderHub.Flags.ESP_Item = false
    SpiderHub.Flags.InfiniteJump = false
    SpiderHub.Flags.Fullbright = false

    for _, connection in pairs(SpiderHub.Connections) do
        Disconnect(connection)
    end

    table.clear(SpiderHub.Connections)
    CancelPickup()
    ClearAllESP()
    RestoreMovement()
    FixCollision()
    RestoreLighting()
    table.clear(itemsByLabel)
    selectedItem = nil

    if Window and not windowDestroyed then
        windowDestroyed = true
        Window:Destroy()
    end
end

local function Rejoin()
    if not SpiderHub.Running then
        return
    end

    if #Players:GetPlayers() <= 1 then
        LocalPlayer:Kick("\nRejoining...")
        task.wait()
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    else
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end
end

local function RequestUnload()
    if not SpiderHub.Running or closeDialogOpen then
        return
    end

    closeDialogOpen = true

    Window:Dialog({
        Title = "Unload Script?",
        Content = "This will stop all features, restore movement, collision, and lighting, remove ESP, and close Spider Hub.",
        Buttons = {
            {
                Title = "Cancel",
                Variant = "Secondary",
                Callback = function()
                    closeDialogOpen = false
                end
            },
            {
                Title = "Unload Script",
                Icon = "power",
                Variant = "Primary",
                Callback = function()
                    closeDialogOpen = false
                    UnloadScript()
                end
            }
        }
    })
end

