local function RefreshItems()
    if not SpiderHub.Running then
        return
    end

    local models = {}
    local nameCounts = {}
    local labels = {}
    local previousSelection = selectedItem
    local selectedLabel

    table.clear(itemsByLabel)

    if itemsFolder and itemsFolder.Parent == Workspace then
        for _, item in ipairs(itemsFolder:GetChildren()) do
            if item:IsA("Model") then
                table.insert(models, item)
                nameCounts[item.Name] = (nameCounts[item.Name] or 0) + 1
            end
        end
    end

    table.sort(models, function(first, second)
        return first.Name < second.Name
    end)

    local nameIndices = {}

    for _, item in ipairs(models) do
        local label = item.Name

        if nameCounts[item.Name] > 1 then
            nameIndices[item.Name] = (nameIndices[item.Name] or 0) + 1
            label = item.Name .. " (" .. nameIndices[item.Name] .. ")"
        end

        while itemsByLabel[label] do
            label = label .. " (item)"
        end

        itemsByLabel[label] = item
        table.insert(labels, label)

        if item == previousSelection then
            selectedLabel = label
        end
    end

    selectedItem = selectedLabel and itemsByLabel[selectedLabel] or nil
    ItemDropdown.Value = selectedLabel
    ItemDropdown:Refresh(labels)
    ItemDropdown:Display()

    if #labels > 0 then
        ItemStatus:SetDesc(tostring(#labels) .. " item(s) available. The list updates automatically.")
        ItemDropdown:Unlock()
        CollectButton:Unlock()
    else
        ItemStatus:SetDesc("No items are currently available. The list will update when they appear.")
        ItemDropdown:Lock()
        CollectButton:Lock()
    end
end

local function BindItemsFolder(folder)
    Disconnect(SpiderHub.Connections.ItemAdded)
    Disconnect(SpiderHub.Connections.ItemRemoved)
    SpiderHub.Connections.ItemAdded = nil
    SpiderHub.Connections.ItemRemoved = nil
    itemsFolder = folder

    if folder then
        SpiderHub.Connections.ItemAdded = folder.ChildAdded:Connect(RefreshItems)
        SpiderHub.Connections.ItemRemoved = folder.ChildRemoved:Connect(RefreshItems)
    end

    RefreshItems()
end

