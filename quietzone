	Name = "Kill Script",

	Callback = function()
		killScript()
	end
})

characterAddedConnection = player.CharacterAdded:Connect(function(character)
	if infiniteStamina then
		startStamina(character)
	end

	if sprintModifierEnabled then
		startSprintModifier(character)
	end
end)

characterRemovingConnection = player.CharacterRemoving:Connect(function(character)
	if infiniteStamina and staminaCharacter == character then
		stopStamina()
	end

	if sprintModifierEnabled and sprintCharacter == character then
		stopSprintModifier(false)
	end
end)
