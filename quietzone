local PlayerTab = Window:CreateTab("Player", "user")
local ESPTab = Window:CreateTab("ESP", "eye")
local SettingsTab = Window:CreateTab("Settings", "settings")

PlayerTab:CreateSection("Movement")

PlayerTab:CreateToggle({
	Name = "Infinite Stamina",
	CurrentValue = false,
	Flag = "InfiniteStamina",

	Callback = function(value)
		if not running then
			return
		end

		infiniteStamina = value

		if value then
			startStamina(player.Character)
		else
			stopStamina()
		end
	end
})

PlayerTab:CreateSlider({
	Name = "Sprint Speed",
	Range = {32, 57},
	Increment = 1,
	Suffix = "",
	CurrentValue = 32,
	Flag = "SprintSpeed",

	Callback = function(value)
		if not running then
			return
		end

		sprintSpeed = value

		if sprintModifierEnabled then
			forceSprintSpeed()
		end
	end
})

PlayerTab:CreateToggle({
	Name = "Sprint Modifier",
	CurrentValue = false,
	Flag = "SprintModifier",

	Callback = function(value)
		if not running then
			return
		end

		sprintModifierEnabled = value

		if value then
			startSprintModifier(player.Character)
		else
			stopSprintModifier(true)
		end
	end
})

