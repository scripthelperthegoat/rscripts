local function requestKillScript()
    if not running or killConfirmationOpen then
        return
    end

    killConfirmationOpen = true

    Window:Dialog({
        Title = "Kill Script?",
        Content = "This will stop all features, remove ESP, restore the original lighting, and close the window. You will need to execute the script again to reopen it.",
        Buttons = {
            {
                Title = "Cancel",
                Variant = "Secondary",
                Callback = function()
                    killConfirmationOpen = false
                end
            },
            {
                Title = "Kill Script",
                Icon = "power",
                Variant = "Primary",
                Callback = function()
                    killConfirmationOpen = false
                    killScript()
                end
            }
        }
    })
end

